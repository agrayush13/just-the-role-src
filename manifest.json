{
  "manifest_version": 3,
  "name": "JustTheRole - Clean job descriptions",
  "short_name": "JustTheRole",
  "version": "0.1.0",
  "description": "Only the role. None of the noise.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/jobs/*"],
  "action": {
    "default_title": "JustTheRole",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["privacy.html"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}
